name: firestoreproto2json
default_branch: main
config:
  description: "Helper library to convert Firestore Protocol Buffer to JSON Object"
  license: Apache-2.0
  language: java17
  release: none
  release_github: true
  status: active
  osv: sarif
  codecov:
    enabled: true
    token: N6CU9DZRIQ
  maven:
    group_id: com.unitvectory
    artifact_id: firestoreproto2json
    javadoc: true
  docs:
    enabled: false
  clip4llm:
    exclude:
      - target
      - .github/**
  gitignore:
    - .vscode
    - /.apt_generated_tests/
